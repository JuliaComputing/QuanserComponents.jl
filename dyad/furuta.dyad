component FurutaPendulum
  world = MultibodyComponents.World() {^world}
  qubependulum = QuanserComponents.QubePendulum() {^qubependulum}
  constant2 = BlockComponents.Sources.Constant(k = 0) {^constant2}
  samplewithadeffects = DiscreteComponents.SampleWithADEffects() {^samplewithadeffects}
  periodicclock = DiscreteComponents.PeriodicClock(dt = 0.1) {^periodicclock}
  samplewithadeffects1 = DiscreteComponents.SampleWithADEffects() {^samplewithadeffects1}
  add = BlockComponents.Math.Add() {^add}
relations
  connect(constant2.y, qubependulum.torque) {^id8}
  connect(samplewithadeffects.u, qubependulum.elbow_angle) {^id9}
  connect(samplewithadeffects.y, add.u2, periodicclock.y) {^id10}
  connect(samplewithadeffects1.u, qubependulum.shoulder_angle) {^id11}
  connect(add.u1, samplewithadeffects1.y) {^id12}
