    },
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}]}},
    "id10": {
      "Dyad": {
        "edges": [
          {"S": 1, "M": [], "E": -1},
          {
            "S": -1,
            "M": [{"x": 200, "y": 360}, {"x": 800, "y": 360}, {"x": 800, "y": 510}],
            "E": 2
          },
