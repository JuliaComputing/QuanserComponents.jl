# Separate files prevent concrete-analysis edits from rewriting the partial declarations.
"""
Replay a designed input sequence open-loop on the QUBE, to collect data for identifying or
calibrating the model's parameters.

Building and running the program is `QubeHardwareRunBase`' job; what belongs to this analysis
is the trajectory to replay and the safety limits the supervisor enforces while replaying it.
Design the sequence with examples/input_design.jl, fit the parameters to what comes back with
examples/pendulum_identification.jl; `run = false` builds the program and exports it without
touching the hardware.

`Tf` defaults to 0, which means "as long as the trajectory": the duration is read off the file
rather than stated twice.
"""
partial analysis FurutaIdentificationBase
  extends QubeHardwareRunBase(export_c = true, output_dir = "identification_c", deploy_dir = "identification_c", umax = 3.0)
  """
  File holding the designed input sequence, as examples/input_design.jl writes it. Copied
  next to the exported C so a deployed run replays the same samples
  """
  parameter traj_file::String = "input_design.csv"
  "Column of `traj_file` holding the voltage, 1-based"
  parameter traj_column::Integer = 1
  "Arm angle [deg] beyond which the command is replaced by a pull-back"
  parameter warn_deg::Real = 95.0
  "Arm angle [deg] beyond which the supervisor latches and commands 0"
  parameter abort_deg::Real = 120.0
  "Pull-back gain past `warn_deg` [V/rad]"
  parameter pullback::Real = 2.0
relations
end
