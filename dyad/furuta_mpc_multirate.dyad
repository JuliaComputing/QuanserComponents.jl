"""
`FurutaMPCMultirate` closed around the simulated `QubePendulum`: the multirate counterpart of
`FurutaMPCSwingup`, which is unchanged and still the single-rate loop.

The plant is sampled and the state estimated at `Ts_fast`; the MPC solves at `Ts` and its move is
held over the whole `Ts`, so the voltage the plant sees is piecewise constant on the MPC's clock
and not on the sensing clock. Two `PeriodicClock`s declare the two rates, the fast one on the
measurement net and the slow one on the command net; both are needed, since nothing else pins the
MPC's partition.

`Ts` must be an integer multiple of `Ts_fast`, and one whose tick instants coincide exactly in
floating point so that the two clocks tick simultaneously and no drift accumulates -- at the
defaults 0.005 is exactly 5 x 0.001, and `m * Ts == 5m * Ts_fast` for every `m`.

Compile with `multibody(model, additional_passes = [SynchToolkit.compile_lustre])` and simulate
with `dt = Ts_fast`: the base step has to resolve the fastest clock.
"""
component FurutaMPCMultirateSwingup
  control_system = FurutaMPCMultirate(final Ts = Ts, final Np = Np, final horizon = horizon, final integrator_stages = integrator_stages) {^control_system}
  qubependulum = QuanserComponents.QubePendulum(idparams = QuanserComponents.identified) {^qubependulum}
  zeroorderhold = DiscreteComponents.ZeroOrderHold(initial_condition = 0) {^zeroorderhold}
  elbow_sampler = DiscreteComponents.SampleWithADEffects(quantized = false, sigma = 0.00001) {^elbow_sampler}
  shoulder_sampler = DiscreteComponents.SampleWithADEffects(quantized = false, sigma = 0.00001) {^shoulder_sampler}
  fastclock = DiscreteComponents.PeriodicClock(final dt = Ts_fast) {^fastclock}
  slowclock = DiscreteComponents.PeriodicClock(final dt = Ts) {^slowclock}
  world = MultibodyComponents.World(default_body_color = gray, default_rod_color = gray, default_joint_color = gray, nominal_length = 0.1, render = false) {^world}
  parameter gray::Real[4] = [0.9, 0.9, 0.9, 1]
  "Sample time of the MPC"
  structural parameter Ts::Real = 0.005
  "Sample time of the encoder sampling and the state estimators"
  structural parameter Ts_fast::Real = 0.001
  "Number of shooting intervals (see `FurutaMPCMultirate`)"
  structural parameter Np::Integer = 50
  "Prediction horizon [s]; the Np intervals grow linearly from Ts to cover it"
  structural parameter horizon::Real = 0.8
  "Stages of the MPC's explicit Runge-Kutta integrator (see `FurutaMPCMultirate`)"
  structural parameter integrator_stages::Integer = 2
relations
  connect(qubependulum.shoulder_angle, shoulder_sampler.u) {^id9}
  connect(qubependulum.elbow_angle, elbow_sampler.u) {^id10}
  connect(shoulder_sampler.y, control_system.shoulder_angle, fastclock.y) {^id11}
  connect(elbow_sampler.y, control_system.elbow_angle) {^id12}
  # The MPC's clock is declared on the command net, the way the sensing clock is declared on the
  # measurement net: this is where the `Latest` reads inside `control_system` get their reading
  # clock, and it is what makes the hold span a whole `Ts`.
  connect(control_system.u, zeroorderhold.u, slowclock.y) {^id13}
  connect(zeroorderhold.y, qubependulum.voltage) {^id14}
metadata {
