"""
Permanent-magnet DC motor driving a rotational axis, with the armature inductance
neglected and **no back-EMF term**.

```math
i = v / R_m, \\quad τ = k_t i
```

The back-EMF `k_t k_m ω / R_m` is deliberately absent. It is exactly proportional to
speed, and so is the speed-dependent part of the friction, so a constant-velocity
experiment cannot tell them apart: it measures volts per rad/s and that is the sum.
Fitting friction and then subtracting a `km` from a datasheet only injects the
disagreement between the two into the result — which is how the friction model ended up
non-dissipative. `FrictionAndBackEMF` on the same axis carries both effects together,
which is why there is no `km` here or in `IdParams`.
"""
component DCMotor
  extends RotationalComponents.Interfaces.PartialTorque
  "Applied armature voltage"
  voltage = Dyad.RealInput() {^voltage}
  "Armature resistance"
  parameter Rm::Dyad.Resistance = 8.4
  "Current-to-torque constant"
  parameter kt::Dyad.ElectricalTorqueConstant = 0.042
  "Armature current"
  variable i::Dyad.Current
  "Torque delivered to the shaft"
  variable tau::Dyad.Torque
relations
  i = voltage / Rm
  tau = kt * i
  spline.tau = -tau
metadata {
  "Dyad": {"icons": {"default": "dyad://QuanserComponents/DCMotor.svg"}},
  "_links": {
    "voltage": {
      "Dyad": {"placement": {"diagram": {"x1": -100, "x2": 0, "y1": 450, "y2": 550}}}
    }
  }
}
end

component QubePendulum
  motor = QuanserComponents.DCMotor(final Rm = Rm, final kt = kt) {^motor}
  voltage = Dyad.RealInput() {^voltage}
  shoulder_joint = MultibodyComponents.Revolute(phi(initial = 0.1), w(initial = 0), rooted = RootedFrame.FrameA(), n = [0, 1, 0], color = [0.8, 0.8, 0.8, 1], radius = 0.01, cylinder_length = 0.03) {^shoulder_joint}
  elbow_joint = MultibodyComponents.Revolute(phi(initial = 0.1), w(initial = 0), rooted = RootedFrame.FrameA(), n = [-1, 0, 0]) {^elbow_joint}
  upper_arm = MultibodyComponents.BodyShape(final m = mr, final r = [r, 0, 0], final r_cm = [r_cm_r, 0, 0], final I_11 = 1e-9, final I_22 = Jr, final I_33 = Jr, radius = 0.0025, color = [0.9, 0.9, 0.9, 1], shapefile = joinpath("assets", "qube", "qube_arm.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotZ(-pi / 2), [0.05, 0, 0])) {^upper_arm}
  lower_arm = MultibodyComponents.BodyShape(final m = mp, final r = [0, -Lp, 0], final r_cm = [0, -l, 0], final I_11 = Jp, I_22 = 1e-9, final I_33 = Jp, radius = 0.00986 / 2, color = [1, 0, 0, 1], shapefile = joinpath("assets", "qube", "qube_pole.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotY(pi / 2) * MultibodyComponents.RotX(pi / 2), [0, -0.058, 0])) {^lower_arm}
  elbow_sensor = RotationalComponents.Sensors.AngleSensor() {^elbow_sensor}
  shoulder_sensor = RotationalComponents.Sensors.AngleSensor() {^shoulder_sensor}
  shoulder_angle = Dyad.RealOutput() {^shoulder_angle}
  elbow_angle = Dyad.RealOutput() {^elbow_angle}
  friction = QuanserComponents.RotationalFrictionAndBackEMF(params = friction_params) {^friction}
  damper1 = RotationalComponents.Components.Damper(final d = bp) {^damper1}
  fixed = MultibodyComponents.Fixed() {^fixed}
  base_box = MultibodyComponents.ShapefileVisualizer(color = [0.1, 0.1, 0.1, 1], shapefile = joinpath("assets", "qube", "qube_block.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotXYZ(-pi / 2, 0, -pi / 2), [0, -0.072, 0])) {^base_box}
  floor = MultibodyComponents.TexturedPlaneVisualizer(texturefile = joinpath("assets", "textures", "sand_02_diff_2k.jpg"), tile = 6, length = 0.5, width = 0.5, length_direction = [1, 0, 0], width_direction = [0, 0, 1], r_shape = [0, -0.11, 0], specular_coefficient = 0.5) {^floor}
  shoulder_cylinder = MultibodyComponents.ShapefileVisualizer(color = [0.7, 0.7, 0.7, 1], shapefile = joinpath("assets", "qube", "qube_motor_drive.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotY(-pi / 2) * MultibodyComponents.RotX(-pi / 2), [0, -0.015, 0])) {^shoulder_cylinder}
  motor_main_mesh = MultibodyComponents.ShapefileVisualizer(color = [0.6, 0.0, 0.0, 1], shapefile = joinpath("assets", "qube", "qube_motor_main.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotY(-pi / 2) * MultibodyComponents.RotX(-pi / 2), [0, 0, 0])) {^motor_main_mesh}
  motor_front_mesh = MultibodyComponents.ShapefileVisualizer(color = [0.1, 0.1, 0.1, 1], shapefile = joinpath("assets", "qube", "qube_motor_front.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotY(-pi / 2) * MultibodyComponents.RotX(-pi / 2), [0.025, 0, 0])) {^motor_front_mesh}
  motor_part_mesh = MultibodyComponents.ShapefileVisualizer(color = [0.5, 0.5, 0.5, 1], shapefile = joinpath("assets", "qube", "qube_motor_part.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotY(-pi / 2) * MultibodyComponents.RotX(-pi / 2), [0.015, -0.016, 0])) {^motor_part_mesh}
  "Physical parameter set (see dyad/definitions.jl: `nominal`, `identified`). Switch the whole set in one line, e.g. QubePendulum(idparams = identified)"
  structural parameter idparams::Native = nominal
  """
  Shoulder-axis speed-dependent torque -- friction *and* back-EMF, the whole of it. There
  is no separate viscous coefficient and no back-EMF in `motor`; see dyad/definitions.jl
  """
  structural parameter friction_params::Native = friction_identified
  "Motor armature resistance"
  parameter Rm::Dyad.Resistance = idparams.Rm
  "Motor current-to-torque constant"
  parameter kt::Dyad.ElectricalTorqueConstant = idparams.kt
  parameter r_cm_r::Dyad.Length = 0.085 / 2
  "Rotary arm (rod) mass (including rotary encoder)"
  parameter mr::Dyad.Mass = idparams.mr
  "Rotary arm (rod) length"
  parameter r::Dyad.Length = idparams.r
  "Rotary arm (rod) moment of inertia about the shoulder pivot"
  parameter Jr::Dyad.Inertia = 0.095 * 0.085 ^ 2 / 3 - 0.095 * (0.085 / 2) ^ 2
  "Pendulum mass"
  parameter mp::Dyad.Mass = idparams.mp
  "Pendulum length"
  parameter Lp::Dyad.Length = idparams.Lp
  "Distance from elbow pivot to pendulum center of mass"
  parameter l::Dyad.Length = idparams.l
  "Pendulum moment of inertia about the elbow pivot."
  parameter Jp::Dyad.Inertia = idparams.Jp
  "Pendulum viscous damping coefficient"
  parameter bp::Dyad.RotationalDampingConstant = idparams.bp
  "Edge length of the cubic base box (visualization only)"
  parameter base_size::Dyad.Length = 0.1
relations
  connect(shoulder_joint.frame_b, upper_arm.frame_a) {^id20}
  connect(upper_arm.frame_b, elbow_joint.frame_a) {^id21}
  connect(elbow_joint.frame_b, lower_arm.frame_a) {^id22}
  connect(elbow_sensor.phi, elbow_angle) {^id23}
  connect(fixed.frame_b, shoulder_joint.frame_a) {^id24}
  connect(voltage, motor.voltage) {^id25}
  connect(shoulder_joint.support, motor.support, friction.spline_a) {^id26}
  connect(shoulder_sensor.spline, motor.spline, shoulder_joint.axis, friction.spline_b) {^id27}
  connect(shoulder_sensor.phi, shoulder_angle) {^id28}
  connect(elbow_joint.support, damper1.spline_a) {^id29}
  connect(damper1.spline_b, elbow_joint.axis) {^id30}
  connect(elbow_sensor.spline, damper1.spline_b) {^id31}
  connect(shoulder_cylinder.frame_a, shoulder_joint.frame_b) {^id32}
  connect(motor_main_mesh.frame_a, shoulder_cylinder.frame_a) {^id33}
  connect(motor_part_mesh.frame_a, motor_main_mesh.frame_a) {^id34}
  connect(motor_front_mesh.frame_a, motor_part_mesh.frame_a) {^id35}
  connect(base_box.frame_a, fixed.frame_b) {^id36}
  connect(floor.frame_a, base_box.frame_a) {^id37}
metadata {
