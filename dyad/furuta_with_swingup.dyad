  "Dyad": {"icons": {"default": "dyad://DiscreteComponents/AngleNormalization.svg"}}
}
end

component LQRstabilizer
  shoulder_angle = Dyad.RealInput() {^shoulder_angle}
  elbow_angle = Dyad.RealInput() {^elbow_angle}
  shoulder_velocity = Dyad.RealInput() {^shoulder_velocity}
  elbow_velocity = Dyad.RealInput() {^elbow_velocity}
  u = Dyad.RealOutput() {^u}
  "State-feedback gain vector applied to the error vector [shoulder_angle, elbow_angle, shoulder_velocity, elbow_velocity]. LQR on the upright-linearized QubePendulum"
  parameter L::Real[4] = [-2.8515070942708687, -24.415803244034326, -0.9920297324372649, -1.9975963404759338]
  variable e::Real[4]
  variable uraw::Real
  parameter umax::Real = 10.0
relations
  e = [0.0 - shoulder_angle,
       pi - elbow_angle,
       0.0 - shoulder_velocity,
       0.0 - elbow_velocity]
  uraw = dot(L, e)
  u = clamp(uraw, -umax, umax)
