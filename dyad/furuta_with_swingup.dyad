component FurutaSwingup
  swingup = DiscreteComponents.Examples.Swingup() {^swingup}
  qubependulum = QuanserComponents.QubePendulum() {^qubependulum}
  zeroorderhold = DiscreteComponents.ZeroOrderHold() {^zeroorderhold}
  elbow_sampler = DiscreteComponents.SampleWithADEffects() {^elbow_sampler}
  shoulder_sampler = DiscreteComponents.SampleWithADEffects() {^shoulder_sampler}
relations
  connect(swingup.u, zeroorderhold.u) {^id6}
  connect(zeroorderhold.y, qubependulum.torque) {^id7}
  connect(qubependulum.elbow_angle, elbow_sampler.u) {^id8}
  connect(qubependulum.shoulder_angle, shoulder_sampler.u) {^id9}
  connect(elbow_sampler.y, swingup.elbow_angle) {^id10}
  connect(shoulder_sampler.y, swingup.shoulder_angle) {^id11}
