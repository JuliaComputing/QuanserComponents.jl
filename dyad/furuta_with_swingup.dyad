"""
Energy-based swingup controller (Åström-style energy pumping) with optional
robustifications against plant-model mismatch:

- `eta`: static relative margin on the energy reference; the controller pumps
  toward `E_ref*(1 + eta)` to compensate for unmodeled dissipation.
- `normalize`: normalizes the energy error by `E_ref`, making the loop gain
  insensitive to errors in `mp` and `Lp` (rescale `k` when enabling).

With the default `eta = 0` and `normalize = false` the control law is

  u = clamp(k*sign(cos(α)*(-dα))*(E - E_ref) - k_center*θ, -umax, umax)

which is algebraically identical to the original block-diagram
implementation of this component.
"""
component EnergySwingup
  elbow_angle = Dyad.RealInput() {^elbow_angle}
  elbow_velocity = Dyad.RealInput() {^elbow_velocity}
  shoulder_angle = Dyad.RealInput() {^shoulder_angle}
  shoulder_velocity = Dyad.RealInput() {^shoulder_velocity}
  realoutput = Dyad.RealOutput() {^realoutput}
  "maximum control signal during swingup"
  parameter umax::Real(min = 0.1, max = 50) = 2
  "Energy-pumping gain"
  parameter k::Real = 80
  "Arm-centering gain pulling the base arm back toward center"
  parameter k_center::Real = 0.2
  "Static relative energy-reference margin"
  parameter eta::Real = 0
  "If true, the energy error is normalized by E_ref (rescale k accordingly)"
  parameter normalize::Boolean = false
  "Pendulum mass as assumed by the controller"
  parameter mp::Real = 0.024
  "Pendulum length as assumed by the controller"
  parameter Lp::Real = 0.129
  "Gravitational acceleration"
  parameter g::Real = 9.81
  final parameter l::Real = Lp / 2
  final parameter Jp_cm::Real = mp * Lp ^ 2 / 12
  "Pendulum energy at upright rest (zero at hanging rest)"
  final parameter E_ref::Real = 2 * mp * g * l
  "Pendulum angle measured from upright"
  variable alpha::Real
  "Estimated pendulum energy"
  variable E::Real
  "Energy error to the (margin-boosted) reference"
  variable Etilde::Real
  "Unsaturated control signal"
  variable uraw::Real
relations
  alpha = elbow_angle - pi
  E = 0.5 * Jp_cm * elbow_velocity ^ 2 + mp * g * l * (1 + cos(alpha))
  Etilde = ifelse(normalize == true,
                  (E - (1 + eta) * E_ref) / E_ref,
                  E - (1 + eta) * E_ref)
  uraw = k * sign(cos(alpha) * (-elbow_velocity)) * Etilde - k_center * shoulder_angle
  realoutput = clamp(uraw, -umax, umax)
end

component Sign
  extends BlockComponents.Interfaces.SISO
relations
  y = sign(u)
metadata {"Dyad": {"icons": {"default": "dyad://DiscreteComponents/Sign.svg"}}}
end

component AngleNormalization
  extends BlockComponents.Interfaces.SISO
relations
  y = mod(u, 2 * pi)
metadata {
  "Dyad": {"icons": {"default": "dyad://DiscreteComponents/AngleNormalization.svg"}}
}
end

component LQRstabilizer
  shoulder_angle = Dyad.RealInput() {^shoulder_angle}
  elbow_angle = Dyad.RealInput() {^elbow_angle}
  shoulder_velocity = Dyad.RealInput() {^shoulder_velocity}
  elbow_velocity = Dyad.RealInput() {^elbow_velocity}
  u = Dyad.RealOutput() {^u}
  "State-feedback gain vector applied to the error vector [shoulder_angle, elbow_angle, shoulder_velocity, elbow_velocity]"
  parameter L1::Real = -9.625743176817387
  parameter L2::Real = 394.43972658274106
  parameter L3::Real = -7.461418005226849
  parameter L4::Real = 84.42279971138271
  variable e1::Real
  variable e2::Real
  variable e3::Real
  variable e4::Real
  variable uraw::Real
  parameter umax::Real = 3.0
relations
  e1 = 0.0 - shoulder_angle
  e2 = pi - elbow_angle
  e3 = 0.0 - shoulder_velocity
  e4 = 0.0 - elbow_velocity
  uraw = L1 * e1 + L2 * e2 + L3 * e3 + L4 * e4
  u = clamp(uraw, -umax, umax)
metadata {
  "Dyad": {"icons": {"default": "dyad://DiscreteComponents/LQRstabilizer.svg"}},
  "_links": {
    "shoulder_angle": {
      "Dyad": {
        "placement": {
