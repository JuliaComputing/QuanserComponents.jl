using BlockComponents

component FurutaSwingup
  swingup = Swingup() {^swingup}
  qubependulum = QuanserComponents.QubePendulum() {^qubependulum}
  zeroorderhold = DiscreteComponents.ZeroOrderHold(initial_condition = 0) {^zeroorderhold}
  elbow_sampler = DiscreteComponents.SampleWithADEffects(quantized = false, sigma = 0.00001, midrise = false, bits = 13, y_min = -4 * pi, y_max = 4 * pi) {^elbow_sampler}
  shoulder_sampler = DiscreteComponents.SampleWithADEffects(quantized = false, sigma = 0.00001, midrise = false, bits = 13, y_min = -4 * pi, y_max = 4 * pi) {^shoulder_sampler}
  periodicclock = DiscreteComponents.PeriodicClock(dt = 0.005) {^periodicclock}
  world = MultibodyComponents.World(default_body_color = gray, default_rod_color = gray, default_joint_color = gray, nominal_length = 0.1, render = false) {^world}
  gain = BlockComponents.Math.Gain(k = 1.0) {^gain}
  parameter gray::Real[4] = [0.9, 0.9, 0.9, 1]
relations
  u_plant: analysis_point(zeroorderhold.y, qubependulum.voltage)
  elbow_y: analysis_point(qubependulum.elbow_angle, elbow_sampler.u)
  shoulder_y: analysis_point(qubependulum.shoulder_angle, shoulder_sampler.u)
  connect(elbow_sampler.y, swingup.elbow_angle) {^id9}
  connect(shoulder_sampler.y, swingup.shoulder_angle, periodicclock.y) {^id10}
  connect(qubependulum.shoulder_angle, shoulder_sampler.u) {^id11}
  connect(zeroorderhold.y, qubependulum.voltage) {^id12}
  connect(qubependulum.elbow_angle, elbow_sampler.u) {^id13}
  connect(gain.u, swingup.u) {^id14}
  connect(gain.y, zeroorderhold.u) {^id15}
