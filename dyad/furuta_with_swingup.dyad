component EnergySwingup
  elbow_angle = Dyad.RealInput() {^elbow_angle}
  elbow_velocity = Dyad.RealInput() {^elbow_velocity}
  shoulder_angle = Dyad.RealInput() {^shoulder_angle}
  shoulder_velocity = Dyad.RealInput() {^shoulder_velocity}
  energy = QuanserComponents.Energy() {^energy}
  sub_pi = BlockComponents.Math.Add(k2 = -1) {^sub_pi}
  constant1 = BlockComponents.Sources.Constant(k = pi) {^constant1}
  energy1 = QuanserComponents.Energy() {^energy1}
  constant2 = BlockComponents.Sources.Constant(k = 0) {^constant2}
  gain = BlockComponents.Math.Gain(k = -100) {^gain}
  arm_centering = BlockComponents.Math.Gain(final k = -arm_centering_gain) {^arm_centering}
  add_centering = BlockComponents.Math.Add() {^add_centering}
  sub_eref = BlockComponents.Math.Add(k2 = -1) {^sub_eref}
  product = BlockComponents.Math.Product() {^product}
  sign = QuanserComponents.Sign() {^sign}
  product1 = BlockComponents.Math.Product() {^product1}
  realoutput = Dyad.RealOutput() {^realoutput}
  limiter = BlockComponents.Nonlinear.Limiter(final y_max = umax, y_min = -umax) {^limiter}
  cos = QuanserComponents.Cos() {^cos}
  gain1 = BlockComponents.Math.Gain(k = -1) {^gain1}
  add = BlockComponents.Math.Add() {^add}
  constant3 = BlockComponents.Sources.Constant(k = 1e-16) {^constant3}
  "maximum control signal during swingup"
  parameter umax::Real(min = 0.1, max = 50) = 3
  "Proportional pull of the arm toward centre during the swing-up [V/rad]; stronger keeps the arm from running into the end stops while the pendulum is pumped up"
  parameter arm_centering_gain::Real = 1.0
relations
  connect(elbow_velocity, energy.dα, gain1.u) {^id23}
  connect(elbow_angle, sub_pi.u1) {^id24}
  connect(constant1.y, sub_pi.u2) {^id25}
  connect(constant2.y, energy1.α) {^id26}
  connect(energy1.dα, constant2.y) {^id27}
  connect(energy1.E, sub_eref.u2) {^id28}
  connect(energy.α, sub_pi.y, cos.u) {^id29}
  connect(product1.u2, sub_eref.y) {^id30}
  connect(product1.y, gain.u) {^id31}
  connect(limiter.y, realoutput) {^id32}
  connect(sub_eref.u1, energy.E) {^id33}
  connect(sign.y, product1.u1) {^id34}
  connect(cos.y, product.u1) {^id35}
  connect(shoulder_angle, arm_centering.u) {^id36}
  connect(arm_centering.y, add_centering.u2) {^id37}
  connect(add_centering.y, limiter.u) {^id38}
  connect(gain.y, add_centering.u1) {^id39}
  connect(gain1.y, product.u2) {^id40}
  connect(add.u2, product.y) {^id41}
  connect(constant3.y, add.u1) {^id42}
  connect(add.y, sign.u) {^id43}
