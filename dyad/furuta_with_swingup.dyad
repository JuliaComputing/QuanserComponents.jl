"""
Variant of `FurutaSwingup` with `delay_n` samples of actuation delay between
the controller output and the zero-order hold, modeling compute/IO latency
as plant-model mismatch. Kept as a separate component because the delay
length is structural (requires a model rebuild to change).
"""
component FurutaSwingupDelayed
  swingup = Swingup() {^swingup}
  qubependulum = QuanserComponents.QubePendulum() {^qubependulum}
  zeroorderhold = DiscreteComponents.ZeroOrderHold(initial_condition = 0) {^zeroorderhold}
  elbow_sampler = DiscreteComponents.SampleWithADEffects(quantized = false, sigma = 0.00001, midrise = false, bits = 13, y_min = -4 * pi, y_max = 4 * pi) {^elbow_sampler}
  shoulder_sampler = DiscreteComponents.SampleWithADEffects(quantized = false, sigma = 0.00001, midrise = false, bits = 13, y_min = -4 * pi, y_max = 4 * pi) {^shoulder_sampler}
  periodicclock = DiscreteComponents.PeriodicClock(dt = 0.005) {^periodicclock}
  world = MultibodyComponents.World(default_body_color = gray, default_rod_color = gray, default_joint_color = gray, nominal_length = 0.1, render = false) {^world}
  gain = BlockComponents.Math.Gain(k = 1.0) {^gain}
  input_delay = DiscreteComponents.NDelay(n = delay_n, initial_condition = 0) {^input_delay}
  parameter gray::Real[4] = [0.9, 0.9, 0.9, 1]
  "Number of samples of actuation delay"
  structural parameter delay_n::Integer = 1
relations
  connect(elbow_sampler.y, swingup.elbow_angle) {^id9}
  connect(shoulder_sampler.y, swingup.shoulder_angle, periodicclock.y) {^id10}
  connect(qubependulum.shoulder_angle, shoulder_sampler.u) {^id11}
  connect(zeroorderhold.y, qubependulum.voltage) {^id12}
  connect(qubependulum.elbow_angle, elbow_sampler.u) {^id13}
  connect(gain.u, swingup.u) {^id14}
  connect(gain.y, input_delay.u) {^id15}
  connect(input_delay.y, zeroorderhold.u) {^id16}
end

component QubePendulum
  torquesource = RotationalComponents.Sources.TorqueSource() {^torquesource}
  voltage = Dyad.RealInput() {^voltage}
  voltage_to_torque = BlockComponents.Math.Gain(final k = kt / Rm) {^voltage_to_torque}
  shoulder_joint = MultibodyComponents.Revolute(phi = initial 0.1, w = initial 0, rooted = RootedFrame.FrameA(), n = [0, 1, 0], color = [0.8, 0.8, 0.8, 1], radius = 0.01, cylinder_length = 0.03) {^shoulder_joint}
  elbow_joint = MultibodyComponents.Revolute(phi = initial 0.1, w = initial 0, rooted = RootedFrame.FrameA(), n = [1, 0, 0]) {^elbow_joint}
  upper_arm = MultibodyComponents.BodyShape(final m = mr, final r = [r, 0, 0], final r_cm = [r / 2, 0, 0], final I_11 = 1e-9, final I_22 = Jr - mr * (r / 2) ^ 2, final I_33 = Jr - mr * (r / 2) ^ 2, radius = 0.0025, color = [0.9, 0.9, 0.9, 1], shapefile = joinpath("assets", "qube", "qube_arm.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotZ(-pi / 2), [0.05, 0, 0])) {^upper_arm}
  lower_arm = MultibodyComponents.BodyShape(final m = mp, final r = [0, -Lp, 0], final r_cm = [0, -l, 0], final I_11 = Jp - mp * l ^ 2, final I_22 = Jp - mp * l ^ 2, final I_33 = Jp - mp * l ^ 2, radius = 0.00986 / 2, color = [1, 0, 0, 1], shapefile = joinpath("assets", "qube", "qube_pole.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotY(pi / 2) * MultibodyComponents.RotX(pi / 2), [0, -0.058, 0])) {^lower_arm}
  elbow_sensor = RotationalComponents.Sensors.AngleSensor() {^elbow_sensor}
  shoulder_sensor = RotationalComponents.Sensors.AngleSensor() {^shoulder_sensor}
  shoulder_angle = Dyad.RealOutput() {^shoulder_angle}
  elbow_angle = Dyad.RealOutput() {^elbow_angle}
  damper = RotationalComponents.Components.Damper(final d = br + kt * km / Rm) {^damper}
  damper1 = RotationalComponents.Components.Damper(final d = bp) {^damper1}
  shoulder_friction = QuanserComponents.SmoothCoulombFriction() {^shoulder_friction}
  elbow_friction = QuanserComponents.SmoothCoulombFriction() {^elbow_friction}
  fixed = MultibodyComponents.Fixed() {^fixed}
  base_box = MultibodyComponents.ShapefileVisualizer(color = [0.1, 0.1, 0.1, 1], shapefile = joinpath("assets", "qube", "qube_block.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotXYZ(-pi / 2, 0, -pi / 2), [0, -0.072, 0])) {^base_box}
  floor = MultibodyComponents.TexturedPlaneVisualizer(texturefile = joinpath("assets", "textures", "sand_02_diff_2k.jpg"), tile = 6, length = 0.5, width = 0.5, length_direction = [1, 0, 0], width_direction = [0, 0, 1], r_shape = [0, -0.11, 0], specular_coefficient = 0.5) {^floor}
  shoulder_cylinder = MultibodyComponents.ShapefileVisualizer(color = [0.7, 0.7, 0.7, 1], shapefile = joinpath("assets", "qube", "qube_motor_drive.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotY(-pi / 2) * MultibodyComponents.RotX(-pi / 2), [0, -0.015, 0])) {^shoulder_cylinder}
  motor_main_mesh = MultibodyComponents.ShapefileVisualizer(color = [0.6, 0.0, 0.0, 1], shapefile = joinpath("assets", "qube", "qube_motor_main.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotY(-pi / 2) * MultibodyComponents.RotX(-pi / 2), [0, 0, 0])) {^motor_main_mesh}
  motor_front_mesh = MultibodyComponents.ShapefileVisualizer(color = [0.1, 0.1, 0.1, 1], shapefile = joinpath("assets", "qube", "qube_motor_front.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotY(-pi / 2) * MultibodyComponents.RotX(-pi / 2), [0.025, 0, 0])) {^motor_front_mesh}
  motor_part_mesh = MultibodyComponents.ShapefileVisualizer(color = [0.5, 0.5, 0.5, 1], shapefile = joinpath("assets", "qube", "qube_motor_part.stl"), shape_transform = MultibodyComponents.Rp2T(MultibodyComponents.RotY(-pi / 2) * MultibodyComponents.RotX(-pi / 2), [0.015, -0.016, 0])) {^motor_part_mesh}
  "Motor armature resistance"
  parameter Rm::Dyad.Resistance = 8.4
  "Motor current-to-torque constant"
  parameter kt::Dyad.ElectricalTorqueConstant = 0.042
  "Motor back-EMF (speed) constant"
  parameter km::Dyad.ElectricalTorqueConstant = 0.042
  "Rotary arm (rod) mass (including rotary encoder)"
  parameter mr::Dyad.Mass = 0.095
  "Rotary arm (rod) length"
  parameter r::Dyad.Length = 0.085
  "Rotary arm (rod) moment of inertia about the shoulder pivot"
  parameter Jr::Dyad.Inertia = mr * r ^ 2 / 3
  "Rotary arm (rod) viscous damping coefficient"
  parameter br::Dyad.RotationalDampingConstant = 0.05e-3
  "Pendulum mass"
  parameter mp::Dyad.Mass = 0.024
  "Pendulum length"
  parameter Lp::Dyad.Length = 0.129
  "Distance from elbow pivot to pendulum center of mass"
  parameter l::Dyad.Length = Lp / 2
  "Pendulum moment of inertia about the elbow pivot"
  parameter Jp::Dyad.Inertia = mp * Lp ^ 2 / 3
  "Pendulum viscous damping coefficient"
  parameter bp::Dyad.RotationalDampingConstant = 0.05 * 5e-5
  "Edge length of the cubic base box (visualization only)"
  parameter base_size::Dyad.Length = 0.1
relations
  connect(shoulder_joint.frame_b, upper_arm.frame_a) {^id20}
  connect(upper_arm.frame_b, elbow_joint.frame_a) {^id21}
  connect(elbow_joint.frame_b, lower_arm.frame_a) {^id22}
  connect(elbow_sensor.phi, elbow_angle) {^id23}
  connect(fixed.frame_b, shoulder_joint.frame_a) {^id24}
  connect(voltage_to_torque.u, voltage) {^id25}
  connect(voltage_to_torque.y, torquesource.tau) {^id26}
  connect(damper.spline_a, shoulder_joint.support) {^id27}
  connect(damper.spline_b, shoulder_joint.axis) {^id28}
  connect(shoulder_joint.support, torquesource.support) {^id29}
  connect(shoulder_sensor.spline, torquesource.spline, shoulder_joint.axis) {^id30}
  connect(shoulder_sensor.phi, shoulder_angle) {^id31}
  connect(elbow_joint.support, damper1.spline_a) {^id32}
  connect(damper1.spline_b, elbow_joint.axis) {^id33}
  connect(shoulder_friction.spline_a, shoulder_joint.support) {^id37}
  connect(shoulder_friction.spline_b, shoulder_joint.axis) {^id38}
  connect(elbow_friction.spline_a, elbow_joint.support) {^id39}
  connect(elbow_friction.spline_b, elbow_joint.axis) {^id40}
  connect(elbow_sensor.spline, damper1.spline_b) {^id34}
  connect(base_box.frame_a, floor.frame_a, fixed.frame_b) {^id35}
  connect(shoulder_cylinder.frame_a, shoulder_joint.frame_b, motor_main_mesh.frame_a, motor_front_mesh.frame_a, motor_part_mesh.frame_a) {^id36}
metadata {
