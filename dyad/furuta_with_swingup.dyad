component QubePendulum
  world = MultibodyComponents.World() {^world}
  torquesource = RotationalComponents.Sources.TorqueSource() {^torquesource}
  torque = Dyad.RealInput() {^torque}
  shoulder_joint = MultibodyComponents.Revolute(rooted = RootedFrame.FrameA()) {^shoulder_joint}
  elbow_joint = MultibodyComponents.Revolute(rooted = RootedFrame.FrameA()) {^elbow_joint}
  upper_arm = MultibodyComponents.BodyCylinder(diameter = 0.006) {^upper_arm}
  lower_arm = MultibodyComponents.BodyCylinder(r = [0, 0.1, 0], diameter = 0.01) {^lower_arm}
  elbow_sensor = RotationalComponents.Sensors.AngleSensor() {^elbow_sensor}
  shoulder_sensor = RotationalComponents.Sensors.AngleSensor() {^shoulder_sensor}
  shoulder_angle = Dyad.RealOutput() {^shoulder_angle}
  elbow_angle = Dyad.RealOutput() {^elbow_angle}
relations
  connect(shoulder_joint.frame_b, upper_arm.frame_a) {^id12}
  connect(upper_arm.frame_b, elbow_joint.frame_a) {^id13}
  connect(elbow_joint.frame_b, lower_arm.frame_a) {^id14}
  connect(torquesource.support, shoulder_joint.support) {^id15}
  connect(torque, torquesource.tau) {^id16}
  connect(elbow_joint.axis, elbow_sensor.spline) {^id17}
  connect(torquesource.spline, shoulder_sensor.spline, shoulder_joint.axis) {^id18}
  connect(shoulder_angle, shoulder_sensor.phi) {^id19}
  connect(shoulder_joint.frame_a, world.frame_b) {^id20}
  connect(elbow_sensor.phi, elbow_angle) {^id21}
