component Energy
  "The angle of the pendulum"
  α = Dyad.RealInput() {^α}
  "The angular velocity of the pendulum"
  dα = Dyad.RealInput() {^dα}
  "The total energy of the pendulum"
  E = Dyad.RealOutput() {^E}
  parameter mp::Real = 0.024
  parameter Lp::Real = 0.129
  parameter g::Real = 9.81
  final parameter l::Real = Lp / 2
  final parameter Jp_cm::Real = mp * Lp ^ 2 / 12
relations
  E = 0.5 * Jp_cm * dα ^ 2 + mp * g * l * (1 + cos(α))
metadata {
  "Dyad": {"icons": {"default": "dyad://QuanserComponents/Energy.svg"}},
  "_links": {
    "α": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": -100, "y1": 200, "x2": 0, "y2": 300, "rot": 0}
        },
        "tags": []
      }
    },
    "dα": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": -100, "y1": 670, "x2": 0, "y2": 770, "rot": 0}
        },
        "tags": []
      }
    },
    "E": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}
        },
        "tags": []
      }
    }
  }
}
end

component VelocityEstimator
  discretederivative = DiscreteComponents.DiscreteDerivative() {^discretederivative}
  exponentialfilter = DiscreteComponents.ExponentialFilter(final a = filter_param) {^exponentialfilter}
  pos = Dyad.RealInput() {^pos}
  vel = Dyad.RealOutput() {^vel}
  parameter filter_param::Real(min = 0, max = 1) = 0.5
relations
  connect(discretederivative.y, exponentialfilter.u) {^id5}
  connect(pos, discretederivative.u) {^id6}
  connect(exponentialfilter.y, vel) {^id7}
metadata {
  "Dyad": {"icons": {"default": "dyad://QuanserComponents/VelocityEstimator.svg"}},
  "_links": {
    "discretederivative": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 330, "y1": 450, "x2": 430, "y2": 550, "rot": 0}
        },
        "tags": []
      }
    },
    "exponentialfilter": {
