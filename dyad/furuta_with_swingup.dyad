component FurutaSwingup
  swingup = DiscreteComponents.Examples.Swingup() {^swingup}
  qubependulum = QuanserComponents.QubePendulum() {^qubependulum}
  zeroorderhold = DiscreteComponents.ZeroOrderHold() {^zeroorderhold}
  elbow_sampler = DiscreteComponents.SampleWithADEffects(quantized = false) {^elbow_sampler}
  shoulder_sampler = DiscreteComponents.SampleWithADEffects(quantized = false) {^shoulder_sampler}
  periodicclock = DiscreteComponents.PeriodicClock(dt = 0.01) {^periodicclock}
  world = MultibodyComponents.World(default_body_color = [0.9, 0.9, 0.9, 1], default_rod_color = [0.9, 0.9, 0.9, 1], default_joint_color = [0.9, 0.9, 0.9, 1], nominal_length = 0.1) {^world}
  constant1 = BlockComponents.Sources.Constant() {^constant1}
relations
  connect(swingup.u, zeroorderhold.u) {^id9}
  connect(elbow_sampler.y, swingup.elbow_angle) {^id10}
  connect(shoulder_sampler.y, swingup.shoulder_angle, periodicclock.y) {^id11}
  connect(constant1.y, qubependulum.torque) {^id12}
  connect(constant1.y, elbow_sampler.u) {^id13}
  connect(constant1.y, shoulder_sampler.u) {^id14}
