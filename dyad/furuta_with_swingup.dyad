"""
Drives the arm to its home position (angle 0) with a super-twisting sliding-mode
controller on the sliding surface s = arm_velocity + lambda*arm_angle, and reports
`done` once the arm has stayed near home (small angle and speed) for `home_time`.
Mirrors QuanserInterface.go_home.

The sliding-mode law is the shared `DiscreteComponents.SuperTwistingSMC` block; the
sliding surface is formed by scaling the arm angle (`lambda_gain`) and adding the
estimated arm velocity (`surface`), and the block output is saturated to ±`th`.
"""
component GoHome
  "Measured arm (shoulder) angle"
  shoulder_angle = Dyad.RealInput() {^shoulder_angle}
  "Homing control command"
  u = Dyad.RealOutput() {^u}
  "1 once the arm has been home for `home_time`, else 0"
  done = Dyad.RealOutput() {^done}
  velocityestimator = QuanserComponents.VelocityEstimator() {^velocityestimator}
  lambda_gain = BlockComponents.Math.Gain(k = lambda) {^lambda_gain}
  surface = BlockComponents.Math.Add() {^surface}
  smc = DiscreteComponents.SuperTwistingSMC(k = k, k2 = k2) {^smc}
  limiter = BlockComponents.Nonlinear.Limiter(y_max = th) {^limiter}
  abs_angle = BlockComponents.Math.Abs() {^abs_angle}
  angle_ok = BlockComponents.Logical.LessThreshold(threshold = angle_tol) {^angle_ok}
  abs_vel = BlockComponents.Math.Abs() {^abs_vel}
  vel_ok = BlockComponents.Logical.LessThreshold(threshold = vel_tol) {^vel_ok}
  homed = BlockComponents.Logical.And() {^homed}
  dwell = DiscreteComponents.SampleTimeSource() {^dwell}
  count_inc = BlockComponents.Math.Add() {^count_inc}
  zero = BlockComponents.Sources.Constant(k = 0) {^zero}
  count_switch = BlockComponents.Logical.Switch() {^count_switch}
  count_delay = DiscreteComponents.UnitDelay(initial_condition = 0) {^count_delay}
  done_cmp = BlockComponents.Logical.GreaterEqualThreshold(threshold = home_time) {^done_cmp}
  done_flag = BlockComponents.Math.BooleanToReal() {^done_flag}
  "Super-twisting control gain"
  parameter k::Real = 0.2
  "Super-twisting integral-term tuning"
  parameter k2::Real = 1.1
  "Homing control saturation"
  parameter th::Real = 5.0
  "Sliding-surface slope (velocity vs angle)"
  parameter lambda::Real = 5.0
  "Arm-angle tolerance for 'home'"
  parameter angle_tol::Real = deg2rad(10)
  "Arm-speed tolerance for 'home'"
  parameter vel_tol::Real = 0.5
  "Time the arm must stay home before `done`"
  parameter home_time::Real = 1.0
relations
  # Sliding-mode homing law: s = arm_velocity + lambda*arm_angle, saturated to ±th
  connect(abs_angle.u, shoulder_angle, lambda_gain.u, velocityestimator.pos) {^id21}
  connect(lambda_gain.y, surface.u1) {^id22}
  connect(velocityestimator.vel, surface.u2) {^id23}
  connect(surface.y, smc.s) {^id24}
  connect(smc.y, limiter.u) {^id25}
  connect(limiter.y, u) {^id26}
  connect(abs_angle.y, angle_ok.u) {^id27}
  connect(velocityestimator.vel, abs_vel.u) {^id28}
  connect(abs_vel.y, vel_ok.u) {^id29}
  connect(angle_ok.y, homed.u1) {^id30}
  connect(vel_ok.y, homed.u2) {^id31}
  # Dwell counter: accumulate Ts while homed, reset to 0 otherwise
  connect(count_delay.y, count_inc.u1) {^id32}
  connect(dwell.y, count_inc.u2) {^id33}
  connect(count_inc.y, count_switch.u1) {^id34}
  connect(zero.y, count_switch.u3) {^id35}
  connect(homed.y, count_switch.u2) {^id36}
  connect(count_switch.y, count_delay.u) {^id37}
  # done once the dwell time reaches home_time
  connect(count_switch.y, done_cmp.u) {^id38}
  connect(done_cmp.y, done_flag.u) {^id39}
  connect(done_flag.y, done) {^id40}
metadata {
