component FurutaSwingup
  swingup = DiscreteComponents.Examples.Swingup() {^swingup}
  qubependulum = QuanserComponents.QubePendulum() {^qubependulum}
  zeroorderhold = DiscreteComponents.ZeroOrderHold() {^zeroorderhold}
  elbow_sampler = DiscreteComponents.SampleWithADEffects(quantized = false) {^elbow_sampler}
  shoulder_sampler = DiscreteComponents.SampleWithADEffects(quantized = false) {^shoulder_sampler}
  periodicclock = DiscreteComponents.PeriodicClock(dt = 0.01) {^periodicclock}
relations
  connect(swingup.u, zeroorderhold.u) {^id7}
  connect(elbow_sampler.y, swingup.elbow_angle) {^id8}
  connect(shoulder_sampler.y, swingup.shoulder_angle, periodicclock.y) {^id9}
  connect(qubependulum.elbow_angle, elbow_sampler.u) {^id10}
  connect(qubependulum.shoulder_angle, shoulder_sampler.u) {^id11}
  connect(zeroorderhold.y, qubependulum.torque) {^id12}
