"""
Top-level controller with a two-state machine: it first runs `GoHome` to home the
arm, then switches to the `RuntimeController` (swing-up + stabilization + error
recovery). If the arm stays out of bounds long enough (out-of-bounds counter beyond
`oob_threshold`), it switches back to `GoHome` and re-homes.
"""
component SwingupWithHoming
  "Measured arm (shoulder) angle"
  shoulder_angle = Dyad.RealInput() {^shoulder_angle}
  "Measured pendulum (elbow) angle"
  elbow_angle = Dyad.RealInput() {^elbow_angle}
  "Control command"
  u = Dyad.RealOutput() {^u}
  gohome = QuanserComponents.GoHome() {^gohome}
  runtime = QuanserComponents.RuntimeController() {^runtime}
  abs_arm = BlockComponents.Math.Abs() {^abs_arm}
  out_of_bounds = BlockComponents.Logical.GreaterThreshold(final threshold = arm_limit) {^out_of_bounds}
  oob_delay = DiscreteComponents.UnitDelay(initial_condition = 0) {^oob_delay}
  increment = BlockComponents.Sources.Constant(final k = oob_increment) {^increment}
  count_up = BlockComponents.Math.Add() {^count_up}
  one = BlockComponents.Sources.Constant(k = 1) {^one}
  count_down = BlockComponents.Math.Add(k2 = -1) {^count_down}
  zero = BlockComponents.Sources.Constant(k = 0) {^zero}
  count_down_clamped = BlockComponents.Math.Max() {^count_down_clamped}
  accumulate = BlockComponents.Logical.Switch() {^accumulate}
  runtime_gate = BlockComponents.Logical.Switch() {^runtime_gate}
  fault = BlockComponents.Logical.GreaterThreshold(final threshold = oob_threshold) {^fault}
  in_runtime_delay = DiscreteComponents.UnitDelay(initial_condition = 0) {^in_runtime_delay}
  was_runtime = BlockComponents.Logical.GreaterThreshold(threshold = 0.5) {^was_runtime}
  not_fault = BlockComponents.Logical.Not() {^not_fault}
  stay_flag = BlockComponents.Math.BooleanToReal() {^stay_flag}
  in_runtime_switch = BlockComponents.Logical.Switch() {^in_runtime_switch}
  in_runtime_now = BlockComponents.Logical.GreaterThreshold(threshold = 0.5) {^in_runtime_now}
  command_switch = BlockComponents.Logical.Switch() {^command_switch}
  "Arm angle beyond which the out-of-bounds counter accumulates"
  parameter arm_limit::Real = 1.9198621771937625
  "Amount added to the out-of-bounds counter each out-of-bounds step"
  parameter oob_increment::Real = 20.0
  "Out-of-bounds counter value that triggers re-homing"
  parameter oob_threshold::Real = 1000.0
relations
  # Route measurements to both sub-controllers
  connect(runtime.shoulder_angle, abs_arm.u, shoulder_angle, gohome.shoulder_angle) {^id25}
  # Out-of-bounds detection: |arm_angle| > arm_limit
  connect(abs_arm.y, out_of_bounds.u) {^id26}
  # Out-of-bounds accumulator (runtime state only):
  #   was_runtime ? (out_of_bounds ? prev + oob_increment : max(prev - 1, 0)) : 0
  connect(oob_delay.y, count_down.u1, count_up.u1) {^id27}
  connect(increment.y, count_up.u2) {^id28}
  connect(one.y, count_down.u2) {^id29}
  connect(count_down.y, count_down_clamped.u1) {^id30}
  connect(zero.y, count_down_clamped.u2) {^id31}
  connect(count_up.y, accumulate.u1) {^id32}
  connect(count_down_clamped.y, accumulate.u3) {^id33}
  connect(out_of_bounds.y, accumulate.u2) {^id34}
  connect(accumulate.y, runtime_gate.u1) {^id35}
  connect(zero.y, runtime_gate.u3) {^id36}
  connect(was_runtime.y, runtime_gate.u2) {^id37}
  connect(runtime_gate.y, oob_delay.u) {^id38}
  connect(runtime_gate.y, fault.u) {^id39}
  # Runtime/home latch:
  #   was_runtime ? (fault ? 0 : 1) : (gohome.done ? 1 : 0)
  connect(in_runtime_delay.y, was_runtime.u) {^id40}
  connect(fault.y, not_fault.u) {^id41}
  connect(not_fault.y, stay_flag.u) {^id42}
  connect(stay_flag.y, in_runtime_switch.u1) {^id43}
  connect(gohome.done, in_runtime_switch.u3) {^id44}
  connect(was_runtime.y, in_runtime_switch.u2) {^id45}
  connect(in_runtime_switch.y, in_runtime_delay.u) {^id46}
  connect(in_runtime_switch.y, in_runtime_now.u) {^id47}
  # Command selection: in_runtime ? runtime.u : gohome.u
  connect(in_runtime_now.y, command_switch.u2) {^id48}
  connect(runtime.u, command_switch.u1) {^id49}
  connect(gohome.u, command_switch.u3) {^id50}
  connect(command_switch.y, u) {^id51}
  connect(runtime.elbow_angle, elbow_angle) {^id52}
metadata {
  "Dyad": {"icons": {"default": "dyad://QuanserComponents/SwingupWithHoming.svg"}},
  "_links": {
    "shoulder_angle": {
