component SwingupCatch
  shoulder_angle = Dyad.RealInput() {^shoulder_angle}
  elbow_angle = Dyad.RealInput() {^elbow_angle}
  u = Dyad.RealOutput() {^u}
  velocityestimator_shoulder = QuanserComponents.VelocityEstimator() {^velocityestimator_shoulder}
  velocityestimator_elbow = QuanserComponents.VelocityEstimator() {^velocityestimator_elbow}
  energyswingup = QuanserComponents.EnergySwingup() {^energyswingup}
  anglenormalization = QuanserComponents.AngleNormalization() {^anglenormalization}
  lqrstabilizer = QuanserComponents.LQRstabilizer(final umax = umax) {^lqrstabilizer}
  neartop = QuanserComponents.NearTop() {^neartop}
  gain = BlockComponents.Math.Gain(k = 1.0) {^gain}
  switch1 = BlockComponents.Logical.Switch() {^switch1}
  friction_ff = QuanserComponents.FrictionAndBackEMF(params = friction_params) {^friction_ff}
  friction_gain = BlockComponents.Math.Gain(final k = friction_comp * volt_per_torque) {^friction_gain}
  friction_add = BlockComponents.Math.Add() {^friction_add}
  "Friction coefficients used for the feedforward (see dyad/definitions.jl)"
  structural parameter friction_params::Native = friction_identified
  """
  Fraction of the modelled friction to compensate. **Defaults to 0**, i.e. the feedforward
  is wired up but inactive.
  """
  parameter friction_comp::Real = 0.0
  "Command needed per unit of motor torque, Rm/kt [V/(N*m)]"
  parameter volt_per_torque::Real = identified.Rm / identified.kt
  """
  Saturation of the stabilizing controller's output [V]. Forwarded to `lqrstabilizer`, and
  a parameter here so a model built around this one can bind it to the motor saturation it
  also clamps the command to (`FurutaHardware` does). The swing-up phase has its own,
  smaller limit in `energyswingup.umax`
  """
  parameter umax::Dyad.Voltage = 10.0
relations
  connect(anglenormalization.y, energyswingup.elbow_angle, lqrstabilizer.elbow_angle, neartop.u) {^id15}
  connect(energyswingup.shoulder_velocity, lqrstabilizer.shoulder_velocity, velocityestimator_shoulder.vel, friction_ff.w) {^id16}
  connect(lqrstabilizer.elbow_velocity, velocityestimator_elbow.vel, energyswingup.elbow_velocity) {^id17}
  connect(shoulder_angle, energyswingup.shoulder_angle, velocityestimator_shoulder.pos, lqrstabilizer.shoulder_angle) {^id18}
  connect(velocityestimator_elbow.pos, elbow_angle, anglenormalization.u) {^id19}
  connect(gain.y, u) {^id20}
  connect(neartop.y, switch1.u2) {^id21}
  # Friction compensation, after switch1 so it applies to whichever controller is active.
  connect(switch1.y, friction_add.u1) {^id22}
  connect(friction_ff.tau_f, friction_gain.u) {^id23}
  connect(friction_gain.y, friction_add.u2) {^id24}
  connect(friction_add.y, gain.u) {^id25}
  connect(switch1.u3, energyswingup.realoutput) {^id26}
  connect(switch1.u1, lqrstabilizer.u) {^id27}
metadata {
  "Dyad": {"icons": {"default": "dyad://QuanserComponents/SwingupCatch.svg"}},
  "_links": {
    "shoulder_angle": {
      "Dyad": {
