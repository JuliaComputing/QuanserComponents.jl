"""
Energy-based swingup controller (Åström-style energy pumping) with optional
robustifications against plant-model mismatch:

- `eta`: static relative margin on the energy reference; the controller pumps
  toward `E_ref*(1 + eta)` to compensate for unmodeled dissipation.
- `normalize`: normalizes the energy error by `E_ref`, making the loop gain
  insensitive to errors in `mp` and `Lp` (rescale `k` when enabling).

The control law is

  u = clamp(k*sign(cos(α)*(-dα))*Ẽ - k_center*θ, -umax, umax)

with Ẽ the (optionally normalized) energy error to the margin-boosted
reference. With `normalize = false`, `eta = 0` and unscaled `k` this is
algebraically identical to the original block-diagram implementation of
this component; the defaults select the robustified configuration
identified by the campaign in `robustness/`.
"""
component EnergySwingup
  elbow_angle = Dyad.RealInput() {^elbow_angle}
  elbow_velocity = Dyad.RealInput() {^elbow_velocity}
  shoulder_angle = Dyad.RealInput() {^shoulder_angle}
  shoulder_velocity = Dyad.RealInput() {^shoulder_velocity}
  "Adaptive relative energy-reference margin (from ErefAdaptation)"
  eta_adapt = Dyad.RealInput() {^eta_adapt}
  realoutput = Dyad.RealOutput() {^realoutput}
  "maximum control signal during swingup"
  parameter umax::Real(min = 0.1, max = 50) = 3
  "Arm-centering gain pulling the base arm back toward center"
  parameter k_center::Real = 1.0
  "Static relative energy-reference margin"
  parameter eta::Real = 0
  "If true, the energy error is normalized by E_ref (rescale k accordingly)"
  parameter normalize::Boolean = true
  "Pendulum mass as assumed by the controller"
  parameter mp::Real = 0.024
  "Pendulum length as assumed by the controller"
  parameter Lp::Real = 0.129
  "Gravitational acceleration"
  parameter g::Real = 9.81
  "Energy-pumping gain; scaled by the upright energy mp*g*Lp = E_ref since it acts on the normalized energy error by default"
  parameter k::Real = 100 * mp * g * Lp
  final parameter l::Real = Lp / 2
  final parameter Jp_cm::Real = mp * Lp ^ 2 / 12
  "Pendulum energy at upright rest (zero at hanging rest)"
  final parameter E_ref::Real = 2 * mp * g * l
  "Pendulum angle measured from upright"
  variable alpha::Real
  "Estimated pendulum energy"
  variable E::Real
  "Energy error to the (margin-boosted) reference"
  variable Etilde::Real
  "Unsaturated control signal"
  variable uraw::Real
relations
  alpha = elbow_angle - pi
  E = 0.5 * Jp_cm * elbow_velocity ^ 2 + mp * g * l * (1 + cos(alpha))
  Etilde = ifelse(normalize == true,
                  (E - (1 + eta + eta_adapt) * E_ref) / E_ref,
                  E - (1 + eta + eta_adapt) * E_ref)
  uraw = k * sign(cos(alpha) * (-elbow_velocity)) * Etilde - k_center * shoulder_angle
  realoutput = clamp(uraw, -umax, umax)
end

"""
Online adaptation of the swingup energy reference.

At each swing apex on the upper half of the circle (velocity zero crossing
while `cos(alpha) < 0`) that occurs during swingup (not stabilized), the
adaptive margin `eta` grows by `gamma` times the apex shortfall `|alpha - pi|`.
This compensates unknown dissipation and drive-gain mismatch without knowing
which parameter is wrong: the reference is only boosted when the pendulum
demonstrably fails to reach the top. The margin is clamped to
`[0, eta_max]` and bleeds off at relative rate `lambda` per sample while the
stabilizer is active, so a later fall restarts from a mild boost. Setting
`gamma = 0` disables adaptation and makes the output identically zero.
"""
component ErefAdaptation@[input clk extends Discrete]
  "Normalized elbow angle in [0, 2pi), pi at upright"
  alpha = RealInput@[clk]() {^alpha}
  "Estimated pendulum angular velocity"
  dalpha = RealInput@[clk]() {^dalpha}
  "Stabilization-active flag from NearTop"
  neartop = BooleanInput@[clk]() {^neartop}
  "Adaptive relative energy-reference margin"
  eta = RealOutput@[clk]() {^eta}
  "Adaptation gain per radian of apex shortfall; 0 disables adaptation"
  parameter gamma::Real = 0.05
  "Upper bound on the adaptive margin"
  parameter eta_max::Real = 0.5
  "Relative decay rate of the margin per sample while stabilized"
  parameter lambda::Real = 0.02
  "Indicator of a swing apex on the upper half during swingup"
  variable apex::Real
  "Adaptive margin state"
  variable etax::Real
relations
  apex = ifelse(dalpha@(clk-1) * dalpha@clk <= 0, 1, 0) * ifelse(cos(alpha) < 0, 1, 0) * ifelse(neartop == true, 0, 1)
  etax@clk = clamp(ifelse(neartop == true,
                          (1 - lambda) * etax@(clk-1),
                          etax@(clk-1) + gamma * apex * abs(alpha - pi)),
                   0, eta_max)
  eta = etax
  initial etax@(clk-1) = 0
  initial dalpha@(clk-1) = 0
end

"""
Isolated test model for `ErefAdaptation`: the pendulum angle is emulated by a
sine around pi that never reaches the top, so eta must ramp at each apex and
saturate at eta_max.
"""
component ErefAdaptationTest
  era = QuanserComponents.ErefAdaptation(gamma = 0.05) {^era}
  alpha_src = BlockComponents.Sources.Sine(amplitude = 0.8, frequency = 0.5, offset = pi) {^alpha_src}
  neartop_src = BlockComponents.Sources.Constant(k = 0) {^neartop_src}
  sampler_alpha = DiscreteComponents.Sampler() {^sampler_alpha}
  sampler_nt = DiscreteComponents.Sampler() {^sampler_nt}
  nt = QuanserComponents.NearTop() {^nt}
  derivative = DiscreteComponents.DiscreteDerivative() {^derivative}
  periodicclock = DiscreteComponents.PeriodicClock(dt = 0.005) {^periodicclock}
  eta = Dyad.RealOutput() {^eta}
relations
  connect(alpha_src.y, sampler_alpha.u) {^id1}
  connect(sampler_alpha.y, era.alpha, derivative.u, periodicclock.y) {^id2}
  connect(derivative.y, era.dalpha) {^id3}
  connect(neartop_src.y, sampler_nt.u) {^id4}
  connect(sampler_nt.y, nt.u) {^id5}
  connect(nt.y, era.neartop) {^id5b}
  connect(era.eta, eta) {^id6}
end

"""
Alpha-beta tracking filter estimating velocity from sampled position: the
steady-state Kalman filter for a constant-velocity kinematic model. Compared
to a discrete derivative followed by a low-pass filter it trades the same
noise suppression for less phase lag. The critically matched gain pairing is
`beta = alpha^2 / (2 - alpha)`.
"""
component AlphaBetaEstimator@[input clk extends Discrete]
  "Sampled position measurement"
  pos = RealInput@[clk]() {^pos}
  "Estimated velocity"
  vel = RealOutput@[clk]() {^vel}
  structural parameter Ts::Real = SampleTime()
  "Position correction gain in (0, 1)"
  parameter alpha::Real = 0.85
  "Velocity correction gain; alpha^2/(2 - alpha) is the critically matched value"
  parameter beta::Real = alpha ^ 2 / (2 - alpha)
  "Position estimate"
  variable x::Real
  "Velocity estimate"
  variable v::Real
  "Predicted position before measurement correction"
  variable xp::Real
relations
  xp = x@(clk-1) + Ts * v@(clk-1)
  x@clk = xp + alpha * (pos@clk - xp)
  v@clk = v@(clk-1) + (beta / Ts) * (pos@clk - xp)
  vel = v
  initial x@(clk-1) = pos@clk
  initial v@(clk-1) = 0
end

"""
Runtime-selectable switch between two velocity estimates, allowing the
alpha-beta estimator to be enabled without a model rebuild while both
estimators stay available for comparison in every simulation.
"""
component EstimatorSwitch
  "Velocity from the original derivative + low-pass estimator"
  v_old = Dyad.RealInput() {^v_old}
  "Velocity from the alpha-beta estimator"
  v_new = Dyad.RealInput() {^v_new}
  y = Dyad.RealOutput() {^y}
  "Select the alpha-beta estimator when true"
  parameter use_new::Boolean = true
relations
  y = ifelse(use_new == true, v_new, v_old)
end

