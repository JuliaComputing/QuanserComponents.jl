"""
The runtime controller: the swing-up/stabilizing `SwingupCatch` wrapped by
`ErrorRecovery`, which overrides the command to recover the arm when it swings
out of bounds.
"""
component RuntimeController
  "Measured arm (shoulder) angle"
  shoulder_angle = Dyad.RealInput() {^shoulder_angle}
  "Measured pendulum (elbow) angle"
  elbow_angle = Dyad.RealInput() {^elbow_angle}
  "Control command"
  u = Dyad.RealOutput() {^u}
  swingup_catch = QuanserComponents.SwingupCatch(final umax = umax) {^swingup_catch}
  errorrecovery = QuanserComponents.ErrorRecovery() {^errorrecovery}
  "Saturation of the stabilizing controller's output [V], forwarded to `swingup_catch`"
  parameter umax::Dyad.Voltage = 10.0
relations
  connect(elbow_angle, swingup_catch.elbow_angle) {^id6}
  connect(swingup_catch.u, errorrecovery.u_swingup) {^id7}
  connect(errorrecovery.u, u) {^id8}
  connect(errorrecovery.shoulder_angle, shoulder_angle, swingup_catch.shoulder_angle) {^id9}
metadata {
  "Dyad": {"icons": {"default": "dyad://QuanserComponents/RuntimeController.svg"}},
  "_links": {
