component Cos
  extends BlockComponents.Interfaces.SISO
relations
  y = cos(u)
end

"""
Overrides the swing-up/stabilizing command with a corrective term that drives the
arm back toward center when it swings past ±arm_limit, matching the out-of-bounds
guard in the hardware control loop.
"""
component ErrorRecovery
  "Measured arm (shoulder) angle"
  shoulder_angle = Dyad.RealInput() {^shoulder_angle}
  "Command from the runtime (swing-up/stabilizing) controller"
  u_swingup = Dyad.RealInput() {^u_swingup}
  "Control command"
  u = Dyad.RealOutput() {^u}
  abs_angle = BlockComponents.Math.Abs() {^abs_angle}
  out_of_bounds = BlockComponents.Logical.GreaterThreshold(threshold = arm_limit) {^out_of_bounds}
  recovery = BlockComponents.Math.Gain(k = recovery_gain) {^recovery}
  selector = BlockComponents.Logical.Switch() {^selector}
  "Arm angle beyond which the corrective term takes over"
  parameter arm_limit::Real = 1.9198621771937625
  "Proportional gain applied to the arm angle when out of bounds"
  parameter recovery_gain::Real = -0.5
relations
  connect(shoulder_angle, recovery.u, abs_angle.u) {^id8}
  connect(abs_angle.y, out_of_bounds.u) {^id9}
  connect(out_of_bounds.y, selector.u2) {^id10}
  connect(recovery.y, selector.u1) {^id11}
  connect(u_swingup, selector.u3) {^id12}
  connect(selector.y, u) {^id13}
