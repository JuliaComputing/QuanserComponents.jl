component QubePendulum
  world = MultibodyComponents.World() {^world}
  torquesource = RotationalComponents.Sources.TorqueSource() {^torquesource}
  torque = Dyad.RealInput() {^torque}
  shoulder_joint = MultibodyComponents.Revolute(rooted = RootedFrame.FrameA()) {^shoulder_joint}
  elbow_joint = MultibodyComponents.Revolute(rooted = RootedFrame.FrameA()) {^elbow_joint}
  upper_arm = MultibodyComponents.BodyCylinder(diameter = 0.005) {^upper_arm}
  lower_arm = MultibodyComponents.BodyCylinder(r = [0, 0.1, 0], diameter = 0.005) {^lower_arm}
  elbow_sensor = RotationalComponents.Sensors.AngleSensor() {^elbow_sensor}
  shoulder_sensor = RotationalComponents.Sensors.AngleSensor() {^shoulder_sensor}
  shoulder_angle = Dyad.RealOutput() {^shoulder_angle}
  elbow_angle = Dyad.RealOutput() {^elbow_angle}
relations
  connect(world.frame_b, shoulder_joint.frame_a) {^id12}
  connect(shoulder_joint.frame_b, upper_arm.frame_a) {^id13}
  connect(upper_arm.frame_b, elbow_joint.frame_a) {^id14}
  connect(elbow_joint.frame_b, lower_arm.frame_a) {^id15}
  connect(torquesource.support, shoulder_joint.support) {^id16}
  connect(torque, torquesource.tau) {^id17}
  connect(elbow_joint.axis, elbow_sensor.spline) {^id18}
  connect(torquesource.spline, shoulder_joint.axis, shoulder_sensor.spline) {^id19}
  connect(shoulder_angle, shoulder_sensor.phi) {^id20}
  connect(elbow_sensor.phi, elbow_angle) {^id21}
