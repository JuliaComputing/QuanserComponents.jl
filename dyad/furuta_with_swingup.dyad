component Energy
  "The angle of the pendulum"
  α = Dyad.RealInput() {^α}
  "The angular velocity of the pendulum"
  dα = Dyad.RealInput() {^dα}
  "The total energy of the pendulum"
  E = Dyad.RealOutput() {^E}
  parameter mp::Real = 0.024
  parameter Lp::Real = 0.129
  parameter g::Real = 9.81
  final parameter l::Real = Lp / 2
  final parameter Jp_cm::Real = mp * Lp ^ 2 / 12
relations
  E = 0.5 * Jp_cm * dα ^ 2 + mp * g * l * (1 + cos(α))
