component QubePendulum
  torquesource = RotationalComponents.Sources.TorqueSource() {^torquesource}
  torque = Dyad.RealInput() {^torque}
  shoulder_joint = MultibodyComponents.Revolute(rooted = RootedFrame.FrameA(), n = [0, 1, 0]) {^shoulder_joint}
  elbow_joint = MultibodyComponents.Revolute(rooted = RootedFrame.FrameA(), n = [1, 0, 0]) {^elbow_joint}
  upper_arm = MultibodyComponents.BodyCylinder(diameter = 0.006, color = [0.9, 0.9, 0.9, 1]) {^upper_arm}
  lower_arm = MultibodyComponents.BodyCylinder(r = [0, 0.1, 0], diameter = 0.01, color = [1, 0, 0, 1]) {^lower_arm}
  elbow_sensor = RotationalComponents.Sensors.AngleSensor() {^elbow_sensor}
  shoulder_sensor = RotationalComponents.Sensors.AngleSensor() {^shoulder_sensor}
  shoulder_angle = Dyad.RealOutput() {^shoulder_angle}
  elbow_angle = Dyad.RealOutput() {^elbow_angle}
  damper = RotationalComponents.Components.Damper(d = 0.07) {^damper}
  damper1 = RotationalComponents.Components.Damper(d = 0.07) {^damper1}
  fixed = MultibodyComponents.Fixed() {^fixed}
relations
  connect(shoulder_joint.frame_b, upper_arm.frame_a) {^id14}
  connect(upper_arm.frame_b, elbow_joint.frame_a) {^id15}
  connect(elbow_joint.frame_b, lower_arm.frame_a) {^id16}
  connect(torquesource.support, shoulder_joint.support) {^id17}
  connect(torque, torquesource.tau) {^id18}
  connect(elbow_joint.axis, elbow_sensor.spline, damper1.spline_b) {^id19}
  connect(torquesource.spline, shoulder_sensor.spline, shoulder_joint.axis, damper.spline_b, damper.spline_a) {^id20}
  connect(shoulder_angle, shoulder_sensor.phi) {^id21}
  connect(elbow_sensor.phi, elbow_angle) {^id22}
  connect(damper1.spline_a, elbow_joint.support) {^id23}
  connect(fixed.frame_b, shoulder_joint.frame_a) {^id24}
