"""
Smooth (regularized) Coulomb friction torque between two rotational splines.

The discontinuous `sign(w_rel)` characteristic is regularized with a `tanh`
of velocity width `w_eps`. With the default `tau_c = 0` the component
produces no torque and the surrounding model behaves as if the component
were absent; its purpose is to inject unmodeled friction as plant-model
mismatch in robustness studies.
"""
component SmoothCoulombFriction
  extends RotationalComponents.Interfaces.PartialCompliantWithRelativeStates
  "Coulomb friction torque magnitude"
  parameter tau_c::Dyad.Torque = 0
  "Velocity width of the tanh regularization"
  parameter w_eps::Dyad.AngularVelocity = 0.01
relations
  tau = tau_c * tanh(w_rel / w_eps)
end

component Energy
  "The angle of the pendulum"
  α = Dyad.RealInput() {^α}
  "The angular velocity of the pendulum"
  dα = Dyad.RealInput() {^dα}
  "The total energy of the pendulum"
  E = Dyad.RealOutput() {^E}
  parameter mp::Real = 0.024
  parameter Lp::Real = 0.129
  parameter g::Real = 9.81
  final parameter l::Real = Lp / 2
  final parameter Jp_cm::Real = mp * Lp ^ 2 / 12
relations
  E = 0.5 * Jp_cm * dα ^ 2 + mp * g * l * (1 + cos(α))
metadata {
  "Dyad": {"icons": {"default": "dyad://DiscreteComponents/Energy.svg"}},
  "_links": {
    "α": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": -100, "y1": 200, "x2": 0, "y2": 300, "rot": 0}
        },
        "tags": []
      }
    },
