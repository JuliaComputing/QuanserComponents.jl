component NearTop
  extends BlockComponents.Interfaces.SISO
  parameter th::Real = 0.4
relations
  y = abs(u - π) < th
metadata {"Dyad": {"icons": {"default": "dyad://DiscreteComponents/NearTop.svg"}}}
end

component StabilizationSwitch
  neartop = RealInput() {^neartop}
  u_lqr = RealInput() {^u_lqr}
  u_swingup = RealInput() {^u_swingup}
  u = RealOutput() {^u}
relations
  u = ifelse(neartop == true, u_lqr, u_swingup)
