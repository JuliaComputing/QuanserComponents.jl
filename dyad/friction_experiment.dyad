partial analysis FurutaFrictionBase
  extends Analysis
  model::Dyad.EmptyComponent = Dyad.EmptyComponent()
  "Sample time [s]"
  parameter Ts::Real = 0.005
  """
  File the program writes its log to. Passed to the `DataLogger` inside the model
  *and* used to open the file, so the two cannot disagree
  """
  parameter log_file::String = "friction_experiment.csv"
  "Run the experiment on the hardware; false only builds the program"
  parameter run::Boolean = true
  "Duration [s]; 0 runs exactly one full up-and-down sweep of the reference"
  parameter Tf::Real = 0.0
  """
  Arm angle [deg] at start-up, added to every shoulder reading. Only the arm's
  *velocity* is used here, so unlike the swing-up this experiment does not care where
  the arm starts; the parameter exists so the logged angle means the same thing
  """
  parameter arm_deg::Real = 0.0
  """
  Card-specific options applied after opening the board. Deadband compensation
  offsets the command in the direction it points, which lands on top of the Coulomb
  term this experiment measures, so it is off by default
  """
  parameter card_options::String = "deadband_compensation=0.0"
  "Motor saturation [V]"
  parameter umax::Real = 10.0
  "Slowest speed in the sweep [rad/s]"
  parameter w_min::Real = 2.0
  "Fastest speed in the sweep [rad/s]"
  parameter w_max::Real = 30.0
  "Number of speeds per direction"
  parameter n_levels::Real = 6
  "Time held at each speed [s]"
  parameter t_step::Real = 2.0
  "Velocity-loop proportional gain [V·s/rad]"
  parameter K::Real = 0.02
  "Velocity-loop integral time [s]"
  parameter Ti::Real = 0.1
  "Backend to build the program on, \"julia\" or \"c\""
  parameter backend::String = "julia"
  """
  Time [s] discarded after each change of the velocity reference. The fit assumes zero
  acceleration, so the transient at each step has to go
  """
  parameter settle::Real = 0.6
  "Largest |arm acceleration| [rad/s²] still counted as constant speed"
  parameter acc_tol::Real = 3.0
  """
  Largest |pendulum velocity| [rad/s] accepted. At constant arm speed the pendulum
  should be at rest too; while it swings it is a torque disturbance
  """
  parameter elbow_tol::Real = 1.5
  "Slowest |velocity| [rad/s] used in the fit; near standstill the sign term is undefined"
  parameter w_min_fit::Real = 0.5
  "Fastest |velocity| [rad/s] used in the fit"
  parameter w_max_fit::Real = 40.0
  "Width of the moving average applied to the acceleration before thresholding, in samples"
  parameter smooth_n::Integer = 20
relations
end

analysis FurutaFrictionExperiment
  extends FurutaFrictionBase()
  model = FurutaFriction()
relations
end
